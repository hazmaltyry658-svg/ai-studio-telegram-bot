# Optional: Telegram user IDs allowed to use admin commands
ADMIN_IDS=

# Storage
DATABASE_PATH=data/bot.sqlite3
OUTPUT_DIR=output
MAX_VIDEO_SECONDS=8
MAX_AUDIO_MINUTES=2
