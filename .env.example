# REQUIRED
TELEGRAM_BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE

# Video generation through Replicate
REPLICATE_API_TOKEN=PASTE_REPLICATE_TOKEN_HERE

# Music generation through ElevenLabs Music API
